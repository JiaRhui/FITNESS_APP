pipeline {

    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Hadolint') {
            steps {
                sh 'bash scripts/run-hadolint.sh'
            }
        }

        stage('Build Staging Containers') {
            steps {
                sh 'docker compose -f docker-compose.staging.yml build'
            }
        }

        stage('Deploy Staging') {
            steps {
                sh '''
                ansible-playbook \
                -i ansible/hosts \
                ansible/deploy_staging_playbook.yaml
                '''
            }
        }

        stage('Verify Deployment - Smoke Curl') {
            steps {
                sh '''
                BACKEND_URL=http://host.docker.internal:4001 \
                FRONTEND_URL=http://host.docker.internal:4000 \
                bash scripts/run-smoke-tests.sh
                '''
            }
        }

    }

    post {

        success {
            echo 'Staging deployment, Hadolint, and smoke curl tests successful.'
        }

        failure {
            echo 'Staging deployment or automated testing failed.'
        }

    }

}
